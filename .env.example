# 复制为 .env 并按需修改（不要把 .env 提交到 git）

# 监听端口与地址
PORT=3000
HOST=0.0.0.0

# SQLite 数据库文件路径（默认 ./data/ledger.db）
# DB_PATH=/var/lib/zhulaicai/ledger.db

# 运行环境：production 会自动开启安全 Cookie
NODE_ENV=production

# 仅当通过 HTTPS 访问时设为 true（否则浏览器不会保存登录 Cookie）
COOKIE_SECURE=true

# 部署在 nginx/caddy 等反向代理之后时设为 true
TRUST_PROXY=true

# 登录有效期（天）
SESSION_TTL_DAYS=30

# 固定登录账号（内部使用，全店共用一本账）
# 修改后重启即生效；改密码会在下次启动时自动更新
LEDGER_USERNAME=zhulaicai
LEDGER_PASSWORD=请改成你自己的密码
